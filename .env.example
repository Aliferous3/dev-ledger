# Dev Ledger — Multi-tenant GitHub SaaS
# Fill values from your Vercel, GitHub App, and Supabase dashboards.
# NEVER commit actual secrets.

# Session cookie secret (use a long random string in production)
SESSION_SECRET=

# Supabase / Postgres
DATABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# GitHub App credentials
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=

# GitHub App webhook verification
GITHUB_WEBHOOK_SECRET=
