# Dev Ledger — GitHub-first SaaS
# Fill values from your GitHub App and Supabase dashboards.
# NEVER commit actual secrets.

# Canonical app URL used for OAuth redirects (defaults to https://$VERCEL_URL)
APP_URL=

# Session cookie secret — long random string, required in production
SESSION_SECRET=

# Postgres / Supabase
DATABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# GitHub App credentials
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=

# GitHub App webhook verification
GITHUB_WEBHOOK_SECRET=

# Vercel Cron bearer secret for /api/cron/sync
CRON_SECRET=
