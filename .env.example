# Dev Ledger — GitHub-first SaaS
# Fill values from your GitHub App and Supabase dashboards.
# NEVER commit actual secrets.

# Canonical app URL used for OAuth redirects (defaults to https://$VERCEL_URL)
APP_URL=https://devledger.site

# Session cookie secret — long random string, required in production
SESSION_SECRET=

# Inactivity lease for non-persistent sessions, in minutes (default 5).
# While an active Dev Ledger tab is open, POST /api/auth/heartbeat renews the
# lease — ordinary dashboard/API reads do NOT slide it. Roughly this many
# minutes without a successful heartbeat → sign-in required. 0 disables.
SESSION_LEASE_MINUTES=5

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres access for `npm run db:migrate` (session pooler; the direct
# db.<ref>.supabase.co endpoint is IPv6-only). Supply the raw password —
# the runner percent-encodes it, so reserved chars (@ # ! $ ; ') are fine.
SUPABASE_DB_PASSWORD=
SUPABASE_DB_HOST=aws-0-ap-southeast-2.pooler.supabase.com
# Supavisor SESSION pooler port (5432) — NOT the transaction pooler (6543);
# dump/migrate/restore connections need session state that transaction
# pooling drops.
SUPABASE_DB_PORT=5432
# Alternative: a full connection string (password must be percent-encoded).
# DATABASE_URL=

# GitHub App credentials
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=

# GitHub App webhook verification
GITHUB_WEBHOOK_SECRET=

# Vercel Cron bearer secret for /api/cron/sync
CRON_SECRET=

# HMAC key for privacy-preserving security-event correlation (server-only).
# Lets security_events group by actor/source without storing raw user ids,
# IPs, or delivery ids. Dedicated key — do NOT reuse SESSION_SECRET,
# CRON_SECRET, or the webhook secret. Optional: unset → hashes are null.
SECURITY_EVENT_HASH_KEY=

# Public client analytics configuration (optional — silent no-ops unset).
# VITE_POSTHOG_* power the PostHog product analytics integration;
# VITE_GA_MEASUREMENT_ID enables GA4 acquisition analytics. Both are
# public, publishable identifiers — never secrets.
VITE_POSTHOG_PROJECT_TOKEN=
VITE_POSTHOG_HOST=
VITE_GA_MEASUREMENT_ID=
