{
  "buildCommand": "npm run build",
  "framework": "vite",
  "functions": {
    "api/sync.mjs": { "maxDuration": 60 },
    "api/sync-range.mjs": { "maxDuration": 60 },
    "api/cron/sync.mjs": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/cron/sync", "schedule": "0 2 * * *" }
  ],
  "rewrites": [
    { "source": "/overview", "destination": "/index.html" },
    { "source": "/activity", "destination": "/index.html" },
    { "source": "/code", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; script-src-attr 'none'; style-src 'self'; style-src-elem 'self'; style-src-attr 'none'; font-src 'self'; img-src 'self' data: https://avatars.githubusercontent.com; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests"
        }
      ]
    }
  ]
}

