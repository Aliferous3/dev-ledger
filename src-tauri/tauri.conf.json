{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dev Ledger",
  "version": "1.3.0",
  "identifier": "site.devledger.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Dev Ledger",
        "width": 1320,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data: asset: http://asset.localhost https://avatars.githubusercontent.com; font-src 'self' data:; style-src 'self'; style-src-attr 'none'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "publisher": "Noaman Ali",
    "homepage": "https://devledger.site",
    "shortDescription": "Open-source GitHub analytics for developers",
    "longDescription": "Dev Ledger turns your GitHub activity into a living analytics ledger — repositories, streaks and momentum — in a native desktop app.",
    "category": "DeveloperTool",
    "copyright": "Copyright © 2025 Noaman Ali",
    "license": "AGPL-3.0-only",
    "windows": {
      "nsis": {
        "installMode": "perUser",
        "displayLanguageSelector": false,
        "languages": ["English"]
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    },
    "macOS": {
      "category": "public.app-category.developer-tools",
      "minimumSystemVersion": "11.0",
      "entitlements": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["dev-ledger"]
      }
    }
  }
}
